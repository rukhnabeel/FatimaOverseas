// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Package {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  type          String   // Umrah | Hajj | Holiday Packages | Hindu Religious Yatra | Group | Family
  durationDays  Int
  price         Int      // stored in paise (e.g. 6500000 = ₹65,000)
  priceLabel    String   // display string e.g. "₹65,000"
  hotelCategory String   // 5★ | 4★ | 3★
  hotelName     String   @default("")
  departureCity String   @default("")
  tag           String   @default("")
  imageUrl      String?
  inclusions    String   // newline-separated list
  itinerary     String
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   @default("General")
  excerpt     String
  content     String
  imageUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id              String  @id @default(cuid())
  whatsappNumber  String  @default("910000000000")
  phoneNumber     String  @default("+91 00000 00000")
  email           String  @default("info@fatimaoverseas.com")
  address         String  @default("123 Main Street, City, State — 123456")
  agencyName      String  @default("Fatima Overseas")
  foundedYear     String  @default("2010")
  licenseNumber   String  @default("")
  facebookUrl     String  @default("")
  instagramUrl    String  @default("")
  youtubeUrl      String  @default("")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Visa {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  country           String   @default("Saudi Arabia")
  price             Int      // stored in paise
  priceLabel        String
  processingTime    String
  validity          String
  documentsRequired String   // newline-separated list
  imageUrl          String?
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
